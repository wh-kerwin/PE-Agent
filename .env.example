# 将本文件复制为 .env.local，再按需要替换配置值。
# .env.local 已被 Git 忽略，真实 API Key 绝不能提交到仓库。

# Compose 部署档案。本地验证使用 mock-recorded 或 mock-live-jev。
PE_AGENT_DEPLOY_PROFILE=mock-live-jev

# 运行环境：development、test 或 production。
PE_AGENT_ENVIRONMENT=development

# 制造平台数据来源：
# mock = 读取仓库内的合成 fixture；platform = 读取客户平台适配器。
PE_AGENT_PLATFORM_PROFILE=mock

# 客户 Case/MES/SPC/FDC 等制造平台 API 的基础地址。
# mock 模式留空；真实平台适配器目前尚未实现。
PE_AGENT_PLATFORM_BASE_URL=

# 决策提供方：
# recorded = 使用确定性的合成录制响应；typesafe = 调用真实 Jev typed decision。
PE_AGENT_DECISION_PROFILE=typesafe

# Jev 使用完整的 System One endpoint，不是普通 API origin。
PE_AGENT_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
# Jev 运行时密钥。本地替换；一旦泄露应立即撤销并重新生成。
PE_AGENT_TYPESAFE_API_KEY=replace-with-jev-key

# 可选的自然语言表达层：
# disabled = 只输出确定性报告；openai_compatible = 附加非权威模型表达文本。
PE_AGENT_EXPLANATION_PROFILE=openai_compatible

# OpenAI-compatible 服务地址，支持 origin、/v1 或完整 /v1/chat/completions。
PE_AGENT_LLM_BASE_URL=https://llm.example.invalid/v1
# OpenAI-compatible 服务接受的模型标识。
PE_AGENT_LLM_MODEL=replace-with-model-name
# OpenAI-compatible 服务密钥；必须与 Jev Key 分开配置。
PE_AGENT_LLM_API_KEY=replace-with-llm-key

# 可选的 LLM 请求限制：总超时、最大尝试次数、最大退避秒数和输出 token 上限。
PE_AGENT_LLM_TIMEOUT_SECONDS=15
PE_AGENT_LLM_MAX_ATTEMPTS=2
PE_AGENT_LLM_MAX_BACKOFF_SECONDS=8
PE_AGENT_LLM_MAX_TOKENS=1000

# Case Book archive 默认关闭；当前仅允许 mock 路径。
PE_AGENT_ARCHIVE_ENABLED=false
# 后端容器内的合成场景路径，不是 Windows 主机路径。
PE_AGENT_MOCK_SCENARIO_PATH=/app/fixtures/pressure-drift-success.json

# 本地 Compose PostgreSQL 密码；生产环境不得复用。
POSTGRES_PASSWORD=synthetic-local-only
