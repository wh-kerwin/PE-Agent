# 客户平台 Production 档案：仅供完成所有审批后的受控试点。
# 当前真实平台 adapter 尚未实现，本文件不代表生产就绪。
PE_AGENT_DEPLOY_PROFILE=platform-production
PE_AGENT_ENVIRONMENT=production

# platform 模式要求客户平台 URL、IAM 集成和正式只读 adapter。
PE_AGENT_PLATFORM_PROFILE=platform
# 使用 TypeSafe Jev typed decision。
PE_AGENT_DECISION_PROFILE=typesafe
# 通用 LLM 表达层默认关闭，完成数据出域和质量审批后才能启用。
PE_AGENT_EXPLANATION_PROFILE=disabled

# Archive 必须保持关闭，直至 review 权限、幂等和回滚方案单独获批。
PE_AGENT_ARCHIVE_ENABLED=false
# 客户 Case/MES/SPC/FDC 平台 API 地址占位符；部署时必须替换。
PE_AGENT_PLATFORM_BASE_URL=https://platform.invalid.example
# Jev 完整 endpoint 占位符；部署时必须替换。
PE_AGENT_TYPESAFE_BASE_URL=https://jev.invalid.example

# 数据库、平台凭据、PE_AGENT_TYPESAFE_API_KEY 和可选 LLM Key 均通过运行时 Secret 注入。
