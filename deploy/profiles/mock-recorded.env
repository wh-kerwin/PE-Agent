# 本地纯 Mock 档案：不访问客户平台、真实 Jev 或通用 LLM。
PE_AGENT_DEPLOY_PROFILE=mock-recorded
PE_AGENT_ENVIRONMENT=development

# 从仓库内合成 fixture 读取制造数据。
PE_AGENT_PLATFORM_PROFILE=mock
# 使用确定性的合成 Jev 录制响应。
PE_AGENT_DECISION_PROFILE=recorded
# 不调用 OpenAI-compatible 表达模型。
PE_AGENT_EXPLANATION_PROFILE=disabled

# Mock Case Book archive 默认关闭。
PE_AGENT_ARCHIVE_ENABLED=false
# 后端容器内的合成场景路径。
PE_AGENT_MOCK_SCENARIO_PATH=/app/fixtures/pressure-drift-success.json
# 仅用于本地 Compose PostgreSQL。
POSTGRES_PASSWORD=synthetic-local-only
