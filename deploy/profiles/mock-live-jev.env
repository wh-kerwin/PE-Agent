# 本地 Mock + Live Jev 档案：制造数据仍为合成数据，决策调用真实 Jev。
PE_AGENT_DEPLOY_PROFILE=mock-live-jev
PE_AGENT_ENVIRONMENT=development

# 从仓库内合成 fixture 读取制造数据，不需要 PE_AGENT_PLATFORM_BASE_URL。
PE_AGENT_PLATFORM_PROFILE=mock
# 使用 TypeSafe Jev 进行 Choice/Score/Noul typed decision。
PE_AGENT_DECISION_PROFILE=typesafe
# 默认不调用 OpenAI-compatible 表达模型；如需启用，请在 .env.local 改为 openai_compatible。
PE_AGENT_EXPLANATION_PROFILE=disabled

# Mock Case Book archive 默认关闭。
PE_AGENT_ARCHIVE_ENABLED=false
# 后端容器内的合成场景路径。
PE_AGENT_MOCK_SCENARIO_PATH=/app/fixtures/pressure-drift-success.json

# Jev endpoint 占位符。真实运行时在 .env.local 配置完整 /v1/systemone 地址。
PE_AGENT_TYPESAFE_BASE_URL=https://jev.invalid.example
# PE_AGENT_TYPESAFE_API_KEY 必须通过 .env.local 或 Secret 注入，绝不能写入本文件。

# 仅用于本地 Compose PostgreSQL。
POSTGRES_PASSWORD=synthetic-local-only
